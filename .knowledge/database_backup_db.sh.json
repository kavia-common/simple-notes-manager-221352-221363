{"is_source_file": true, "format": "bash", "description": "A shell script for detecting and backing up various types of databases (SQLite, PostgreSQL, MySQL, MongoDB). The script checks for the presence of each database type, verifies availability, and performs backups accordingly.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "sudo mysqladmin ping", "mysqladmin ping", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "shell script", "database backup", "SQLite", "PostgreSQL", "MySQL", "MongoDB", "database detection", "shell database script"], "state": 2, "file_id": 3, "knowledge_revision": 12, "git_revision": "837058b435f60d65be51d01980d4a4e85911d123", "hash": "d7da372b768c895a33088027314656c3", "format-version": 4, "code-base-name": "database", "filename": "database/backup_db.sh", "revision_history": [{"12": "837058b435f60d65be51d01980d4a4e85911d123"}]}